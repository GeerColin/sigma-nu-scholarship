# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privileged server-only Supabase access. Must start with sb_secret_.
# This bypasses RLS and must never be exposed to a browser or used for ordinary requests.
# Leave unset unless a narrowly scoped privileged server workflow explicitly requires it.
SUPABASE_SECRET_KEY=

# Local Supabase Google provider configuration only.
# Hosted Google provider values are configured in the Supabase Dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Sigma Nu Scholarship <scholarship@example.org>"
EMAIL_REPLY_TO=
EMAIL_MODE=mock

# Trusted deployment origin used for OAuth callbacks and secure links.
# Local: http://localhost:3000
# Production: https://sigma-nu-scholarship.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
